__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/
.DS_Store

# Credentials — never commit. Real keys live in the system keyring or
# ~/.etoro-tui/.env (outside the repo). These patterns are belt-and-braces
# in case a credential file is ever copied or generated inside the repo cwd.
.env
.env.*
*.envfile
.etoro-tui/
*.key
*.pem
credentials.*
secrets.*

# Coverage artefacts. `.coverage` is a file and `htmlcov/` a directory,
# so both forms are needed; a bare `htmlcov` would not match the directory.
.coverage
.coverage.*
htmlcov/
